# Copy to .env for local dev; set these in Render dashboard for prod
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///mymarket.db   # Render Postgres URL for prod
CRON_SECRET=change-me-cron-secret
BASE_DOMAIN=mymarket.ug
ADMIN_EMAIL=admin@mymarket.ug
ADMIN_PASSWORD=change-me-admin-password
# Web Push (generate with: vapid --gen && vapid --applicationServerKey)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=admin@mymarket.ug

# Flutterwave (MTN MoMo / Airtel Money) — leave blank for simulated payments
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
FLW_WEBHOOK_HASH=

# Africa's Talking SMS — use username "sandbox" for testing
AT_USERNAME=
AT_API_KEY=
